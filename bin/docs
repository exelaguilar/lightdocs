#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Runs the Lightdocs command-line application.
 *
 * CLI commands use TinyMVC's reusable runtime without entering an HTTP route.
 */
define('APP_CONTEXT', 'frontend');

require dirname(__DIR__) . '/upload/system/startup.php';

$bootstrap = new \System\Engine\Bootstrap(
	context: APP_CONTEXT,
	application_root: DIR_ROOT,
	local_config_file: null,
);
$registry = $bootstrap->boot();

exit((new \System\Console\Console($registry))->run($argv));
